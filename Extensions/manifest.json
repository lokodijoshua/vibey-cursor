{
  "manifest_version": 3,
  "name": "VibeyCursor",
  "version": "2.0",
  "description": "Hover any element, copy its full design as an AI prompt.",
  "permissions": ["activeTab", "clipboardWrite", "storage", "downloads", "sidePanel", "scripting", "alarms"],
  "host_permissions": ["https://vibeycursor-backend.vercel.app/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VibeyCursor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": {
    "toggle-inspector": {
      "suggested_key": { "default": "Ctrl+Shift+V", "mac": "Command+Shift+V" },
      "description": "Toggle VibeyCursor on/off"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "lib/html2canvas.min.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
